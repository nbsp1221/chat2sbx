# Optional shell environment overrides. Source this file before running chat2sbx.
export CHAT2SBX_HOST=127.0.0.1
export CHAT2SBX_PORT=18788
export CHAT2SBX_DATA_ROOT="${HOME}/.chat2sbx"
export CHAT2SBX_STATE_DIR="${HOME}/.chat2sbx/state"
export CHAT2SBX_WORKSPACE_ROOT="${HOME}/.chat2sbx/workspaces"
export CHAT2SBX_DATABASE_PATH="${HOME}/.chat2sbx/state/chat2sbx.sqlite"
export CHAT2SBX_ALLOWED_HOST_ROOTS="${HOME}/repositories"
export CHAT2SBX_SECRET_DIR="${HOME}/.secrets/tunnel-client"
export CHAT2SBX_TUNNEL_CLIENT="${HOME}/.local/bin/tunnel-client"
export CHAT2SBX_ENABLE_TUNNEL=1
# export CHAT2SBX_MAX_ACTIVE_SANDBOXES=4
